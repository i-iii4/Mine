{
  "manifest_version": 3,
  "name": "Mine",
  "version": "0.1.0",
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "description": "Save links, articles, and images to Mine",
  "permissions": [
    "contextMenus",
    "activeTab",
    "nativeMessaging",
    "storage",
    "scripting",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://public.api.bsky.app/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Mine",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "lib/twitterThreadSelection.js",
        "lib/twitterTweetContent.js",
        "lib/xLongformArticleExtraction.js",
        "lib/extractionDocumentSanitizer.js",
        "lib/tweetTextCompletion.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "dist/overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Open Mine"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png",
        "icons/clipper-overlay-32.png",
        "dist/assets/popup.css",
        "dist/fonts/Geist-Variable.woff2",
        "dist/fonts/GeistMono-Variable.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
