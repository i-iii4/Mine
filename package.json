{
  "name": "mine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:side": "cargo tauri dev --config src-tauri/tauri.dev-side.conf.json",
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "test": "bun run test:frontend && bun run test:rust && bun run test:startup-packaging && bun run test:scripts",
    "test:scripts": "node --test scripts/disposable-app-home.test.mjs scripts/run-with-disposable-home.test.mjs",
    "test:frontend": "bun run build:save-core && vitest run",
    "test:feed-scroll": "node scripts/feed-scroll-audit.mjs",
    "test:graph": "node scripts/graph-view-audit.mjs",
    "test:cold-space": "node scripts/cold-space-browser-audit.mjs",
    "test:sidebar-reorder": "node scripts/sidebar-reorder-audit.mjs",
    "test:edge-states": "node scripts/edge-states-audit.mjs",
    "test:selection-menu": "node scripts/selection-menu-audit.mjs",
    "test:sidebar-actions": "node scripts/sidebar-action-audit.mjs",
    "test:top-row": "node scripts/top-row-wrap-audit.mjs",
    "test:narrow-window": "node scripts/narrow-window-audit.mjs",
    "test:detail-image-geometry": "node scripts/detail-image-geometry-audit.mjs",
    "test:reading-mode": "node scripts/reading-mode-audit.mjs",
    "test:native-shell": "node scripts/native-shell-smoke.mjs",
    "test:native-capture": "node scripts/native-capture-smoke.mjs",
    "test:clipper-worker": "bun run build:extension && node scripts/clipper-worker-smoke.mjs && node scripts/x-thread-smoke.mjs",
    "test:x-thread": "bun run build:extension && node scripts/x-thread-smoke.mjs",
    "test:clipper-worker-built": "node scripts/clipper-worker-smoke.mjs",
    "test:clipper-native-built": "node scripts/clipper-native-lifecycle.mjs",
    "test:clipper-native-transport": "node --test scripts/clipper-native-relay.test.mjs",
    "test:clipper-native-release": "node scripts/clipper-native-lifecycle.mjs --extension \"$PWD/target/release/bundle/macos/Mine.app/Contents/Resources/clipper-extension\" --host \"$PWD/target/release/bundle/macos/Mine.app/Contents/MacOS/native-host\" --scanner \"$PWD/target/debug/cold-space-audit\"",
    "test:clipper-install": "node --test scripts/clipper-extension-payload.test.mjs",
    "test:startup-packaging": "node --test scripts/clipper-runtime-manifest.test.mjs scripts/startup-packaging.test.mjs scripts/finalize-local-bundle.test.mjs",
    "test:reliability": "node --test scripts/reliability-registry-check.test.mjs scripts/test-reach.test.mjs scripts/reliability-source-guard.test.mjs scripts/prepare-update-channel.test.mjs scripts/build-identity.test.mjs scripts/install-clipper-host.test.mjs scripts/install-cli.test.mjs scripts/clipper-runtime-manifest.test.mjs scripts/verify-extension-mirrors.test.mjs scripts/finalize-local-bundle.test.mjs scripts/install-local-app.test.mjs scripts/verify-bundle-binaries.test.mjs scripts/fetch-ytdlp.test.mjs",
    "test:reliability-updates": "vitest run extension/popup/lib/protocol.test.ts extension/popup/lib/saveOperation.test.ts extension/popup/hooks/useClipperState.standalone.test.tsx extension/background.connection.test.ts extension/background.messaging.test.ts extension/lib/standaloneVault.test.ts extension/lib/standaloneVault.recovery.test.ts",
    "test:reliability-source": "node scripts/reliability-source-guard.mjs -- cargo test -p mine --lib --no-default-features --locked reliability_external_fixture",
    "test:reliability-index-source": "bun run test:reliability-source",
    "updates:prepare": "node scripts/prepare-update-channel.mjs",
    "check:reliability-registry": "node scripts/reliability-registry-check.mjs",
    "check:release-evidence": "node scripts/reliability-registry-check.mjs --release",
    "verify:extension-mirrors": "node scripts/verify-extension-mirrors.mjs",
    "verify:startup-bundle": "node scripts/verify-startup-bundle.mjs",
    "test:startup:real": "node scripts/startup-performance-acceptance.mjs",
    "test:browser": "node scripts/browser-audits.mjs",
    "test:chrome": "node scripts/settings-menu-audit.mjs",
    "test:rust": "bun run fetch:ytdlp && node scripts/run-with-disposable-home.mjs cargo test --workspace --all-targets --features tooling --locked",
    "test:watch": "vitest",
    "bindings:generate": "bun run fetch:ytdlp && cargo run -p mine --bin export-bindings --features tooling --locked",
    "bindings:check": "bun run fetch:ytdlp && cargo run -p mine --bin export-bindings --features tooling --locked -- --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.extension.json",
    "verify:core": "bun run check:reliability-registry && bun run test:reliability && bun run test:save-core && bun run bindings:check && bun run lint && bun run build && bun run test",
    "verify": "bun run verify:core && bun run test:browser",
    "verify:release": "bun run check:release-evidence && bun run verify && bun run test:clipper-worker && bun run test:clipper-native-transport && bun run test:clipper-native-release && bun run test:native-shell && bun run verify:bundle-binaries",
    "build:extension": "node scripts/build-extension.mjs",
    "build:local-app": "bunx tauri build --bundles app && node scripts/clipper-worker-smoke.mjs --extension \"$PWD/target/release/bundle/macos/Mine.app/Contents/Resources/clipper-extension\" && bun run finalize:local-app",
    "finalize:local-app": "node scripts/finalize-local-bundle.mjs --bundle target/release/bundle/macos/Mine.app --ad-hoc && bun run verify:bundle-binaries",
    "verify:bundle-binaries": "node scripts/verify-bundle-binaries.mjs --bundle target/release/bundle/macos/Mine.app",
    "install:local-app": "node scripts/install-local-app.mjs target/release/bundle/macos/Mine.app --open",
    "cli:install": "bash scripts/install-cli.sh",
    "clipper:install-host": "node scripts/install-clipper-host.mjs",
    "pack:extension": "node scripts/build-extension.mjs --pack",
    "preview": "vite preview",
    "tauri": "tauri",
    "fetch:ytdlp": "node scripts/fetch-ytdlp.mjs",
    "build:save-core": "node scripts/build-save-core.mjs --test-runtime",
    "test:save-core": "bun run build:save-core && node scripts/test-save-core.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "katex": "0.16.47",
    "lowlight": "3.3.0",
    "lucide-react": "^0.575.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "12.1.0",
    "micromark-util-character": "2.1.1",
    "micromark-util-chunked": "2.0.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-resolve-all": "2.0.1",
    "parse5": "^8.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.13.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "tailwind-merge": "^3.5.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.37",
    "@types/d3-force": "^3.0.10",
    "@types/hast": "3.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "3.0.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.0.2",
    "jsdom": "^28.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-util-types": "2.0.2",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "remark-rehype": "11.1.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.2.1",
    "turndown": "^7.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vfile": "6.0.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "cytoscape": "3.34.3",
    "dompurify": "3.4.16",
    "mdast-util-find-and-replace": "3.0.2",
    "package-manager-detector": "1.8.0",
    "uuid": "14.0.2"
  }
}
