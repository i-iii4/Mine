{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for tab pages, tab bars and the settings window, matched by page label (SPEC_TABS.md, В24)",
  "webviews": [
    "tab-*",
    "tabbar-*",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-set-app-theme",
    "core:window:allow-start-dragging",
    "dialog:default",
    "dialog:allow-open",
    "opener:default",
    "clipboard-manager:allow-write-text"
  ]
}
