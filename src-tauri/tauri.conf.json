{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mine",
  "version": "0.1.0",
  "identifier": "com.mine.app",
  "build": {
    "features": [
      "desktop"
    ],
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run fetch:ytdlp && bun run dev",
    "beforeBuildCommand": "bun run fetch:ytdlp && bun run build && bun run build:extension",
    "beforeBundleCommand": "node scripts/build-clipper-runtime-manifest.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: http: data:; media-src 'self' asset: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-src 'self' http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/yt-dlp": "binaries/yt-dlp",
      "binaries/icloud-progress-helper": "binaries/icloud-progress-helper",
      "binaries/video-mux-helper": "binaries/video-mux-helper",
      "../build/clipper-extension/": "clipper-extension/",
      "../build/clipper-runtime-manifest.json": "clipper-runtime-manifest.json"
    }
  }
}
