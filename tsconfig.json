{
  // Everything at once, so `bunx tsc --noEmit` checks the app's pages, the
  // clipper with its JavaScript (JSDoc, checkJs) and every test. One program
  // holds the globals of all their runtimes together: Node and Vitest for the
  // tests, chrome.* for the clipper. That code uses no global or library its
  // own runtime lacks is checked by tsconfig.app.json and
  // tsconfig.extension.json, one runtime each; `bun run typecheck` checks all
  // three. They are not references: a reference to a program with the same
  // files makes tsc look for that program's output (TS6305).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Vitest runs on Node 22; the referenced programs keep the pages to ES2021.
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["node", "vitest/globals", "chrome", "vite/client"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src", "extension"],
  "exclude": [
    // Build output: the popup bundle and the save core glue wasm-bindgen
    // generates.
    "extension/dist",
    "extension/generated",
    // Vendored Defuddle release: one minified UMD bundle of a third-party
    // library, not source of this project. lib/defuddle.d.ts declares the
    // part the clipper calls.
    "extension/lib/defuddle.js"
  ]
}
